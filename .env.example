# ============================================================
# ST-Risk-For-UAV — 环境变量配置
# ============================================================
# 复制此文件为 .env 并修改为实际值:
#   cp .env.example .env
#
# 优先级: 环境变量 > .env 文件 > 代码默认值
# ============================================================

# ── 数据库 (PostgreSQL + PostGIS + pgvector) ─────────────────
# Node 后端使用 postgres.js 驱动 (同步)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/st_risk
# Python 后端使用 asyncpg 驱动 (异步)，需加 +asyncpg 前缀
UAV_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/st_risk

# ── Node 后端 ────────────────────────────────────────────────
NODE_API_PORT=3000
NODE_ENV=development
# Python 后端地址 (Node 调用 Python 算法服务)
PYTHON_BACKEND_URL=http://localhost:8000

# ── Python 后端 ──────────────────────────────────────────────
PYTHON_API_HOST=0.0.0.0
PYTHON_API_PORT=8000
UAV_DEBUG=false

# ── Python 算法参数 ──────────────────────────────────────────
# 默认栅格分辨率 (米)
UAV_DEFAULT_GRID_RESOLUTION=1.0
# 默认搜索裕度 (米)
UAV_DEFAULT_SEARCH_MARGIN=50.0
# 风险评估阈值 (0-1)
UAV_RISK_COLLISION_THRESHOLD=0.7
UAV_RISK_WEATHER_THRESHOLD=0.6
UAV_RISK_BATTERY_THRESHOLD=0.8
# 最低电量保留比例
UAV_MIN_BATTERY_RESERVE=0.2

# ── 前端 (Vite 环境变量需以 VITE_ 开头) ─────────────────────
# 通常不需要手动设置，Vite 代理已配置好
# VITE_NODE_API_URL=/api/v1
# VITE_PYTHON_API_URL=/api/python
