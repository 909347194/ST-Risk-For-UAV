FROM node:22-slim AS builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@latest --activate

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
COPY packages/shared-ts ./packages/shared-ts
COPY apps/server/node-backend ./apps/server/node-backend

RUN pnpm install --frozen-lockfile || pnpm install
RUN pnpm --filter @st-risk/node-backend build

FROM node:22-slim

WORKDIR /app

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/shared-ts ./packages/shared-ts
COPY --from=builder /app/apps/server/node-backend/dist ./dist
COPY --from=builder /app/apps/server/node-backend/package.json ./

EXPOSE 3000

CMD ["node", "dist/main.js"]
