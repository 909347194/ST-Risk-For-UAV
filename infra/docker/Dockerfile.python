FROM python:3.12-slim

WORKDIR /app

RUN pip install uv

COPY apps/server/python-fastapi-backend/pyproject.toml apps/server/python-fastapi-backend/uv.lock* ./
RUN uv sync --no-dev --frozen || pip install fastapi uvicorn[standard] pydantic pydantic-settings sqlalchemy[asyncio] asyncpg geoalchemy2 pgvector alembic

COPY apps/server/python-fastapi-backend/src ./src

EXPOSE 8000

CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000"]
